{
  "name": "can-qure-root",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend-web && npm run dev",
    "install-all": "npm install && cd backend && npm install && cd ../frontend-web && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}